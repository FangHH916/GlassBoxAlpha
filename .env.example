# Safe default: deterministic replay, no network, no orders.
BROKER_MODE=demo
EXECUTION_MODE=preview
UNDERLYINGS=SPY,QQQ

# Alpaca paper credentials. Create a fresh competition-only paper account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
COMPETITION_ACCOUNT_ID=
COMPETITION_START_UTC=2026-08-28T15:00:00+00:00

# Official sponsor-tool integration. CLI is the default execution backend.
ALPACA_EXECUTION_BACKEND=cli
ALPACA_CLI_PATH=alpaca
OPTION_FEED=indicative

# Optional veto-only OpenAI critic. Without it, replay uses a deterministic critic.
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Triple interlock. Leave these values unchanged for replay/preview.
ALLOW_PAPER_ORDERS=false
PAPER_ORDER_CONFIRMATION=

# Candidate and contract selection.
FAST_EMA=20
SLOW_EMA=50
MIN_SIGNAL_SCORE=0.45
MIN_CONFIDENCE=0.64
MIN_DTE=7
MAX_DTE=21
TARGET_LONG_DELTA=0.55
TARGET_SHORT_DELTA=0.30

# Hard risk limits.
RISK_PER_TRADE_PCT=0.005
MAX_OPTION_EXPOSURE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.0125
MAX_DRAWDOWN_PCT=0.03
MAX_TRADES_PER_DAY=3
MAX_OPTION_POSITIONS=1
MAX_CONTRACTS_PER_TRADE=3
MIN_OPEN_INTEREST=500
MAX_QUOTE_SPREAD_PCT=0.12
MAX_QUOTE_AGE_SECONDS=30
MAX_DATA_AGE_SECONDS=900
MIN_MINUTES_TO_CLOSE=45
COMPETITION_STARTING_BALANCE=100000

